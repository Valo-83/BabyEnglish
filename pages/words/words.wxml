<!--pages/words/words.wxml-->
<view class="container">
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="page-title">学习存储库</text>
  </view>

  <view class="storage-hero">
    <text class="hero-title">AI 学习资产中心</text>
    <text class="hero-subtitle">保存已生成故事，沉淀孩子的本地学习记忆</text>
    <view class="hero-actions">
      <view class="hero-action-btn" bindtap="goToMyStories">
        <text>我的小故事</text>
      </view>
      <view class="hero-action-btn secondary" bindtap="exportLearningPackage">
        <text>导出资料包</text>
      </view>
      <view class="hero-action-btn secondary" bindtap="importLearningPackage">
        <text>导入资料包</text>
      </view>
    </view>
  </view>

  <view class="storage-value-section">
    <text class="section-title">本地学习资产</text>
    <view class="value-grid">
      <view class="value-item">
        <text class="value-number">{{stats.totalStories}}</text>
        <text class="value-label">已保存 AI 故事</text>
      </view>
      <view class="value-item">
        <text class="value-number">{{stats.totalCacheHits}}</text>
        <text class="value-label">本地打开次数</text>
      </view>
      <view class="value-item">
        <text class="value-number">{{stats.savedValueCount}}</text>
        <text class="value-label">节省重复生成</text>
      </view>
    </view>
    <text class="value-desc">这些故事已保存在本地，可反复复习，减少重复生成，让 AI 内容沉淀为孩子自己的学习资产。</text>
  </view>

  <view class="filter-section" wx:if="{{hasAssets}}">
    <input class="search-input"
           value="{{searchKeyword}}"
           bindinput="onSearchInput"
           placeholder="搜索单词或故事内容" />
    <scroll-view class="filter-row" scroll-x="{{true}}">
      <view class="filter-chip {{categoryFilter === item.value ? 'active' : ''}}"
            wx:for="{{categoryOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            catchtap="selectCategory">
        <text>{{item.label}}</text>
      </view>
    </scroll-view>
    <scroll-view class="filter-row" scroll-x="{{true}}">
      <view class="filter-chip status-chip {{statusFilter === item.value ? 'active' : ''}}"
            wx:for="{{statusOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            catchtap="selectStatus">
        <text>{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="today-review-section" wx:if="{{todayReview.length}}">
    <text class="section-title">今日复习</text>
    <text class="section-subtitle">今日建议复习 {{todayReview.length}} 个单词</text>
    <view class="review-cards">
      <view class="review-card" wx:for="{{todayReview}}" wx:key="word">
        <text class="review-emoji">{{item.emoji}}</text>
        <view class="review-info">
          <text class="review-word">{{item.word}}</text>
          <text class="review-meta">上次学习：{{item.relativeTime}}  ·  复习 {{item.reviewCount}} 次</text>
        </view>
        <view class="review-btn" bindtap="startReview" data-word="{{item.word}}" data-category="{{item.category}}">
          <text>开始复习</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!hasAssets}}">
    <text class="empty-icon">🗂️</text>
    <text class="empty-title">还没有本地学习资产</text>
    <text class="empty-desc">先进入分类学习页生成 AI 故事，故事会自动保存到这里。</text>
  </view>

  <view class="empty-state" wx:elif="{{hasAssets && !hasFilteredAssets}}">
    <text class="empty-icon">🔎</text>
    <text class="empty-title">没有找到匹配内容</text>
    <text class="empty-desc">可以换一个单词、故事关键词或筛选条件试试。</text>
  </view>

  <view class="asset-list" wx:else>
    <view class="asset-card" wx:for="{{assets}}" wx:key="word">
      <view class="asset-main" bindtap="toggleAsset" data-word="{{item.word}}">
        <view class="asset-emoji">
          <text>{{item.emoji}}</text>
        </view>
        <view class="asset-info">
          <view class="asset-title-row">
            <text class="asset-word">{{item.word}}</text>
            <text class="asset-chinese">{{item.chinese}}</text>
          </view>
          <text class="asset-summary">{{item.summary}}</text>
          <view class="asset-tags">
            <text class="asset-tag">已本地保存</text>
            <text class="asset-tag">故事 {{item.storyCount}} 篇</text>
            <text class="asset-tag">复习 {{item.reviewCount}} 次</text>
            <text class="asset-tag">本地打开 {{item.cacheHitCount}} 次</text>
            <text class="asset-tag status-tag status-{{item.status}}">{{statusMap[item.status]}}</text>
          </view>
        </view>
      </view>

      <view class="asset-detail" wx:if="{{expandedWord === item.word}}">
        <text class="detail-label">完整故事</text>
        <text class="detail-story">{{item.full}}</text>
        <view class="detail-meta">
          <text>保存：{{item.saveTimeText}}</text>
          <text>发音：{{item.listenCount}} 次</text>
        </view>
        <view class="mini-actions" wx:if="{{item.status !== 'mastered'}}">
          <view class="mini-btn mastered-btn" bindtap="markAsMastered" data-word="{{item.word}}" wx:if="{{item.status !== 'mastered'}}">
            <text>标为已熟悉</text>
          </view>
        </view>
        <view class="asset-actions">
          <view class="action-btn primary" bindtap="continueLearning" data-category="{{item.category}}" data-word="{{item.word}}">
            <text>继续学习</text>
          </view>
          <view class="action-btn danger" bindtap="deleteAsset" data-word="{{item.word}}" data-storage-key="{{item.storageKey}}">
            <text>删除缓存</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 导入预览弹窗 -->
<view class="preview-overlay" wx:if="{{showImportPreview}}" catchtap="cancelImport">
  <view class="preview-modal" catchtap="">
    <view class="preview-header">
      <text class="preview-title">导入资料包预览</text>
      <text class="preview-close" bindtap="cancelImport">✕</text>
    </view>
    <view class="preview-body">
      <view class="preview-meta" wx:if="{{importPreview}}">
        <text class="preview-package-title">{{importPreview.title}}</text>
        <text class="preview-package-desc">{{importPreview.description}}</text>
      </view>
      <view class="preview-stats" wx:if="{{importPreview}}">
        <view class="preview-stat-item">
          <text class="preview-stat-icon">📖</text>
          <text class="preview-stat-label">{{importPreview.storyText}}</text>
        </view>
        <view class="preview-stat-item">
          <text class="preview-stat-icon">🔊</text>
          <text class="preview-stat-label">{{importPreview.audioText}}</text>
        </view>
        <view class="preview-stat-item">
          <text class="preview-stat-icon">📝</text>
          <text class="preview-stat-label">{{importPreview.recordText}}</text>
        </view>
      </view>
      <view class="preview-words" wx:if="{{importPreview && importPreview.words && importPreview.words.length}}">
        <text class="preview-words-label">包含单词：</text>
        <view class="preview-word-chips">
          <text class="preview-word-chip" wx:for="{{importPreview.words}}" wx:key="*this">{{item}}</text>
          <text class="preview-word-chip more" wx:if="{{importPreview.wordCount > 8}}">+{{importPreview.wordCount - 8}} 个</text>
        </view>
      </view>
      <view class="preview-notice">
        <text>导入不会覆盖已有故事，仅合并新内容。</text>
      </view>
    </view>
    <view class="preview-footer">
      <view class="preview-btn cancel" bindtap="cancelImport">
        <text>取消</text>
      </view>
      <view class="preview-btn confirm" bindtap="confirmImport">
        <text>确认导入</text>
      </view>
    </view>
  </view>
</view>
