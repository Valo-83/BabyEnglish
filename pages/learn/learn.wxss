/* pages/learn/learn.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #E1F5FE 0%, #FFF9C4 100%);
  overflow: hidden;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  flex-shrink: 0;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.back-icon {
  font-size: 48rpx;
  color: black;
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-right: 80rpx;
}

/* 卡片区域：相对定位容器，swiper + 故事浮层 */
.card-area {
  flex: 1;
  position: relative;
  min-height: 0;
  margin-bottom: 20rpx;
}

/* swiper 填满整个 card-area */
.card-swiper {
  width: 100%;
  height: 100%;
}

.word-card {
  margin: 10rpx;
  padding: 40rpx 30rpx;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  height: 100%;
  box-sizing: border-box;
  gap: 8rpx;
}

.image-wrapper {
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50%;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.1);
  flex-shrink: 0;
}

.emoji {
  font-size: 140rpx;
}

.word-wrapper {
  margin: 8rpx 0;
  padding: 15rpx 40rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  flex-shrink: 0;
}

.english-word {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 6rpx;
}

.meaning-wrapper {
  flex-shrink: 0;
}

.chinese-meaning {
  font-size: 34rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.sound-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e89797;
  padding: 16rpx 50rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 107, 0.4);
  flex-shrink: 0;
}

.sound-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.sound-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.sound-text {
  font-size: 30rpx;
  color: white;
  font-weight: bold;
}

/* === AI 故事浮层（绝对定位，不占用流式布局空间） === */
.story-panel {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  max-height: 45%;
  display: flex;
  flex-direction: column;
  z-index: 10;
  overflow: hidden;
}

.story-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
  flex-shrink: 0;
}

.story-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.story-toggle {
  padding: 6rpx 20rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.story-toggle:active {
  background: #e0e0e0;
}

.story-loading {
  padding: 30rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.story-scroll {
  max-height: 280rpx;
  padding: 20rpx 24rpx;
}

.story-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  word-break: break-word;
}

.story-error {
  padding: 30rpx;
  text-align: center;
  font-size: 28rpx;
  color: #e74c3c;
}

/* === 故事浮层操作按钮 === */
.story-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 20rpx;
  padding: 12rpx 24rpx 20rpx;
  border-top: 1rpx solid #f5f5f5;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.story-action-btn {
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.story-action-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.mastered-btn {
  background: #4CAF50;
  color: white;
}

.story-audio-btn {
  background: #FF9800;
  color: white;
}

.new-story-btn {
  background: #7E57C2;
  color: white;
}

.story-audio-btn.audio-loading {
  background: #BDBDBD;
  opacity: 0.8;
}

.story-audio-btn.audio-playing {
  background: #2196F3;
}

/* === 进度和导航 === */
.progress-bar {
  text-align: center;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.progress-text {
  font-size: 26rpx;
  color: #999;
  background: white;
  padding: 6rpx 26rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.nav-buttons {
  display: flex;
  justify-content: space-around;
  padding: 0 40rpx;
  flex-shrink: 0;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
}

.nav-btn {
  padding: 18rpx 45rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 12rpx rgba(0,0,0,0.1);
}

.nav-btn:active {
  transform: scale(0.95);
}

.prev-btn {
  background: #E0E0E0;
  color: #666;
}

.next-btn {
  background: #4CAF50;
  color: white;
}
