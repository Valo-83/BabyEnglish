/* pages/words/words.wxss */
.container {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #F3FBFF 0%, #FFF8E8 100%);
  box-sizing: border-box;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: 20rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 18rpx rgba(31, 93, 130, 0.12);
}

.back-icon {
  font-size: 42rpx;
  color: #1D6B8F;
}

.page-title {
  flex: 1;
  text-align: center;
  margin-right: 72rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #174A63;
}

.storage-hero {
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: white;
  box-shadow: 0 10rpx 28rpx rgba(31, 93, 130, 0.12);
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #174A63;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: #557484;
}

/* 本地学习资产 */
.storage-value-section {
  margin: 28rpx 0;
  padding: 32rpx;
  border-radius: 24rpx;
  background: white;
  box-shadow: 0 10rpx 28rpx rgba(31, 93, 130, 0.12);
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #174A63;
  margin-bottom: 8rpx;
}

.section-subtitle {
  display: block;
  font-size: 26rpx;
  color: #557484;
  margin-bottom: 20rpx;
}

.value-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 20rpx 0;
}

.value-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  background: #F7FCFE;
}

.value-number {
  font-size: 40rpx;
  font-weight: 800;
  color: #F08A24;
  margin-bottom: 6rpx;
}

.value-label {
  font-size: 22rpx;
  color: #557484;
  text-align: center;
}

.value-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6D8793;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEF4F4;
}

/* 今日复习 */
.today-review-section {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: white;
  box-shadow: 0 10rpx 28rpx rgba(31, 93, 130, 0.12);
}

.review-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.review-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F7FCFE;
}

.review-emoji {
  font-size: 52rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #EDF6FA;
  flex-shrink: 0;
}

.review-info {
  flex: 1;
  min-width: 0;
}

.review-word {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #174A63;
  margin-bottom: 6rpx;
}

.review-meta {
  display: block;
  font-size: 22rpx;
  color: #6D8793;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.review-btn {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #1E9BB2;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.review-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.empty-state {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: #557484;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #174A63;
  margin-bottom: 12rpx;
}

.empty-desc {
  max-width: 560rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.asset-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.asset-card {
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(31, 93, 130, 0.1);
  overflow: hidden;
}

.asset-main {
  display: flex;
  gap: 22rpx;
  padding: 28rpx;
}

.asset-emoji {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #F2FAFD;
  font-size: 54rpx;
}

.asset-info {
  flex: 1;
  min-width: 0;
}

.asset-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.asset-word {
  font-size: 36rpx;
  font-weight: 800;
  color: #174A63;
}

.asset-chinese {
  font-size: 26rpx;
  color: #557484;
}

.asset-summary {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: #405E6B;
  margin-bottom: 16rpx;
}

.asset-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.asset-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #EAF7F7;
  color: #2A7778;
  font-size: 22rpx;
}

/* 状态标签 */
.status-tag {
  font-weight: 600;
}

.status-new {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-reviewing {
  background: #FFF3E0;
  color: #E65100;
}

.status-mastered {
  background: #F3E5F5;
  color: #6A1B9A;
}

.asset-detail {
  padding: 0 28rpx 28rpx;
  border-top: 1rpx solid #EEF4F4;
}

.detail-label {
  display: block;
  padding-top: 24rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #F08A24;
  font-weight: 700;
}

.detail-story {
  display: block;
  max-height: 300rpx;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.65;
  color: #304B58;
  white-space: pre-wrap;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin: 20rpx 0;
  color: #6D8793;
  font-size: 22rpx;
}

/* 小操作按钮 */
.mini-actions {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.mini-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.mastered-btn {
  background: #F3E5F5;
  color: #7B1FA2;
}

.review-btn-secondary {
  background: #E8F5E9;
  color: #2E7D32;
}

.mini-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.asset-actions {
  display: flex;
  gap: 18rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.action-btn.primary {
  background: #1E9BB2;
  color: #FFFFFF;
}

.action-btn.danger {
  background: #FFF0EC;
  color: #D64545;
}
