/* pages/index/index.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9C4 0%, #E1F5FE 100%);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.title {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: rgb(4, 196, 196);
  margin-bottom: 30rpx;
  text-shadow: 4rpx 4rpx 8rpx rgb(223, 243, 6);
}

.subtitle {
  display: block;
  font-size: 36rpx;
  color: #1885df;
  text-shadow:4rpx 4rpx 8rpx #c3ff00;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 45rpx;
}

.category-item {
  width: 280rpx;
  height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(239, 252, 167, 0.781);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  transition: all 0.3s;
}

.storage-entry {
  width: 620rpx;
  height: 220rpx;
  flex-direction: row;
  justify-content: flex-start;
  gap: 32rpx;
  padding: 0 42rpx;
  box-sizing: border-box;
  background: rgba(238, 249, 177, 0.95);
}

.storage-entry .icon-wrapper {
  margin-bottom: 0;
}

.category-item:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.icon {
  font-size: 90rpx;
}

.category-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.footer {
  text-align: center;
  margin-top: 80rpx;
  padding-bottom: 40rpx;
}

.tip {
  font-size: 28rpx;
  color: #999;
}
