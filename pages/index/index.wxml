<!--pages/index/index.wxml-->
<view class="container">
  <view class="header">
    <text class="title">英语点读</text>
    <text class="subtitle">快乐学英语</text>
  </view>

  <view class="category-list">
    <view class="category-item" bindtap="goToLearn" data-type="animals">
      <view class="icon-wrapper" style="background-color: #bc8011;">
        <text class="icon">🐶</text>
      </view>
      <text class="category-name">动物</text>
    </view>

    <view class="category-item" bindtap="goToLearn" data-type="fruits">
      <view class="icon-wrapper" style="background-color: #E8F5E9;">
        <text class="icon">🍎</text>
      </view>
      <text class="category-name">水果</text>
    </view>

    <view class="category-item" bindtap="goToLearn" data-type="colors">
      <view class="icon-wrapper" style="background-color: #E3F2FD;">
        <text class="icon">🎨</text>
      </view>
      <text class="category-name">颜色</text>
    </view>

    <view class="category-item" bindtap="goToLearn" data-type="numbers">
      <view class="icon-wrapper" style="background-color: #F3E5F5;">
        <text class="icon">🔢</text>
      </view>
      <text class="category-name">数字</text>
    </view>

    <view class="category-item storage-entry" bindtap="goToStorage">
      <view class="icon-wrapper" style="background-color: #DDF7F0;">
        <text class="icon">🗂️</text>
      </view>
      <text class="category-name">学习存储库</text>
    </view>
  </view>

  <view class="footer">
    <text class="tip">点击卡片学习，生成的 AI 故事会进入学习存储库。</text>
  </view>
</view>
